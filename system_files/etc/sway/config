# Grok Bot OS kiosk. No panel, no desktop, no window chrome.
# tty1 autologins grokbot, whose shell execs sway, which runs grokbot-kiosk.
# grokbot-kiosk restarts grokbot-launch whenever that process exits.
# sway itself does not restart a crashed exec child.
#
# The visible app is whatever grokbot-launch starts. The native Grok Bot
# RPM's desktop file sets StartupWMClass=grok-bot, and app.conf sets
# GROKBOT_APP_ID=grok-bot so Super+G / Alt+G can focus it. The placeholder
# Firefox window uses app_id firefox. Other installed apps are also fullscreen.
# fuzzel is a layer-shell launcher, so it is not a window and is not
# covered by the fullscreen rule.
#
# Keybindings (Alt as well as Super): some VM consoles, including UTM,
# do not forward the Super key. Alt+Tab / Alt+F4 are the fallbacks that
# were added after a real kiosk boot left the user with no way to move
# or close a window (docs/DECISIONS.md, 2026-07-11 and 2026-07-13).
#
# Logs: this process's stdout/stderr, including the app it launches.
# Read them from another VT: cat ~grokbot/.local/share/grokbot/shell.log

output * background #000000 solid_color

exec sh -c 'mkdir -p "$HOME/.local/share/grokbot" "$HOME/Apps" "$HOME/.local/share/applications" && exec /usr/local/bin/grokbot-kiosk >>"$HOME/.local/share/grokbot/shell.log" 2>&1'

default_border none
default_floating_border none
hide_edge_borders both

bar {
    mode invisible
}

for_window [app_id=".*"] fullscreen enable

bindsym Mod4+space exec /usr/local/bin/grokbot-switch
bindsym Mod1+space exec /usr/local/bin/grokbot-switch
bindsym Mod4+g exec /usr/local/bin/grokbot-focus
bindsym Mod1+g exec /usr/local/bin/grokbot-focus
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev
bindsym Mod1+F4 kill
