# Minimal kiosk config for the AI-OS shell (ROADMAP.md Phase 4).
# `webshell_cli` starts a local HTTP server and opens Firefox in --kiosk
# mode against it -- that Firefox window IS the desktop the user sees
# (prompt bar + command/app tile grid), not a terminal. Any other Firefox
# window it opens along the way (e.g. `claude login`'s own OAuth
# redirect) is fullscreened by the same rule below, and closing it
# returns focus to the kiosk window underneath. The `/cli` built-in
# command (webshell/commands.py) spawns `foot` directly -- also
# fullscreened, so it behaves exactly like the OAuth case: it takes over
# the screen, and closing it (exit/Ctrl+D) reveals the kiosk window
# again. No bar, no window borders, no other desktop chrome.
#
# stdout/stderr (Python tracebacks, Firefox's own errors -- it's a
# subprocess of webshell_cli, inherits the same fds) are redirected to a
# log file instead of going nowhere: sway takes over the console's
# graphics mode, so anything not captured is simply unrecoverable if this
# fails silently. Switch to another VT (e.g. Ctrl+Alt+F2) and
# `cat ~aios/.local/share/oais/shell.log` (as root, or `sudo -u aios`) to
# read it after a failed boot.

exec sh -c 'mkdir -p "$HOME/.local/share/oais" && cd /usr/lib/oais/orchestrator && exec python3 -m orchestrator.webshell_cli >>"$HOME/.local/share/oais/shell.log" 2>&1'

default_border none
default_floating_border none

bar {
    mode invisible
}

for_window [app_id="firefox"] fullscreen enable
for_window [app_id="foot"] fullscreen enable
