# Grok Bot OS: switch English/Korean with the Hangul (한/영) key,
# Shift+Space or Right Alt. Many Korean laptops send Right Alt for 한/영.
[Hotkey]
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False

[Hotkey/TriggerKeys]
0=Hangul
1=Shift+space
2=Alt_R

[Behavior]
ActiveByDefault=False
ShareInputState=All
ShowInputMethodInformation=True
