#!/bin/sh
# $BROWSER / xdg-open target.
#
# The placeholder kiosk is Firefox --kiosk --no-remote on its own profile.
# A second Firefox that shares that profile, or that remotes into it, opens
# as a tab in the same chromeless window and the user cannot get back
# (docs/DECISIONS.md, 2026-07-13). This wrapper uses a different profile and
# --new-window so external URLs get their own top-level window.
PROFILE="${HOME}/.local/share/grokbot/external-browser-profile"
mkdir -p "$PROFILE"
exec firefox --new-window --profile "$PROFILE" "$@"
