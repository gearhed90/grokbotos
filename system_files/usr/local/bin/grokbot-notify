#!/bin/bash
# Notification daemon wrapper (mako). Started by sway.
#   grokbot-notify --serve    run mako, restart if it dies
set -euo pipefail
sys_conf=${GROKBOT_MAKO_SYS_CONF:-/etc/grokbot/mako.conf}
user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/mako/config"
if [[ ${1:-} != "--serve" ]]; then
    echo "usage: grokbot-notify --serve" >&2
    exit 2
fi
while true; do
    if [[ -f $user_conf ]]; then
        mako || true
    else
        mako --config "$sys_conf" || true
    fi
    sleep 1
done
