#!/bin/bash
# Change the desktop wallpaper for the current user.
#
#   grokbot-wallpaper show
#   grokbot-wallpaper set <image-path> [fill|fit|stretch|center|tile]
#   grokbot-wallpaper color <#rrggbb>
#   grokbot-wallpaper reset
#
# Writes ~/.config/grokbot/desktop.conf. Defaults: /etc/grokbot/desktop.conf.
set -euo pipefail

SYS_CONF="${GROKBOT_DESKTOP_SYS_CONF:-/etc/grokbot/desktop.conf}"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/grokbot"
USER_CONF="${USER_DIR}/desktop.conf"

die() { echo "grokbot-wallpaper: $*" >&2; exit 2; }

get() {
    local key="$1" f line
    local v="$2"
    for f in "$SYS_CONF" "$USER_CONF"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]]; then
                v="${BASH_REMATCH[1]}"
            fi
        done <"$f"
    done
    printf '%s\n' "$v"
}

put() {
    local key="$1" value="$2" tmp
    mkdir -p "$USER_DIR"
    [[ -f "$USER_CONF" ]] || printf '[desktop]\n' >"$USER_CONF"
    tmp="$(mktemp "${USER_CONF}.XXXXXX")"
    awk -v k="$key" -v v="$value" '
        BEGIN { done = 0 }
        $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { if (!done) print k " = " v; done = 1; next }
        { print }
        END { if (!done) print k " = " v }
    ' "$USER_CONF" >"$tmp"
    mv "$tmp" "$USER_CONF"
}

reload() {
    # grokbot-desktop restarts swaybg with the new config.
    pkill -u "$(id -u)" -x swaybg 2>/dev/null || true
}

case "${1:-show}" in
    show)
        printf 'wallpaper = %s\nmode = %s\ncolor = %s\n' \
            "$(get wallpaper "")" "$(get mode fill)" "$(get color '#000000')"
        ;;
    set)
        [[ $# -ge 2 && $# -le 3 ]] || die "usage: set <image-path> [mode]"
        path="$2"
        [[ "$path" == /* ]] || path="$(pwd)/${path}"
        [[ -f "$path" && -r "$path" ]] || die "not a readable file: $path"
        [[ "$path" != *$'\n'* ]] || die "bad path"
        put wallpaper "$path"
        if [[ $# -eq 3 ]]; then
            case "$3" in fill | fit | stretch | center | tile) put mode "$3" ;; *) die "unknown mode: $3" ;; esac
        fi
        reload
        ;;
    color)
        [[ $# -eq 2 && "$2" =~ ^#[0-9A-Fa-f]{6}$ ]] || die "color needs #rrggbb"
        put color "$2"
        reload
        ;;
    reset)
        rm -f "$USER_CONF"
        reload
        ;;
    -h | --help | help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1" ;;
esac
