#!/bin/bash
# Lock the screen with swaylock.
#   grokbot-lock             lock now (used by Super+L and swayidle)
#   grokbot-lock --suspend   lock, then suspend
#   grokbot-lock --first-boot  open the PIN setup once if no PIN is set
# Without a PIN the kiosk user has no password, so swaylock could never
# be unlocked. In that case this never locks: it opens the PIN setup.
set -euo pipefail
user=$(id -un)
pin_state=$(/usr/local/bin/grokbot-lock-setup --status)
skip_file="${XDG_CONFIG_HOME:-$HOME/.config}/grokbot/lock-setup-skipped"

open_setup() {
    if pgrep -u "$user" -f 'app-id=grokbot-lock-setup' >/dev/null; then
        return 0
    fi
    swaymsg -q "exec foot --app-id=grokbot-lock-setup --title='화면 잠금 PIN / Screen lock PIN' /usr/local/bin/grokbot-lock-setup" || true
}

case ${1:-} in
    --first-boot)
        if [[ $pin_state == "unset" && ! -e $skip_file ]]; then
            # Grok Bot maps its window after sway starts and takes focus.
            # Wait for it (up to 90 s), then open the setup and focus it,
            # or the PIN prompt gets no keystrokes (seen in a VM boot).
            app_id=grok-bot
            if [[ -r /etc/grokbot/app.conf ]]; then
                # shellcheck disable=SC1091
                app_id=$(source /etc/grokbot/app.conf && echo "${GROKBOT_APP_ID:-grok-bot}")
            fi
            for _ in $(seq 90); do
                swaymsg -t get_tree 2>/dev/null | grep -q "\"app_id\": \"${app_id}\"" && break
                sleep 1
            done
            sleep 2
            open_setup
            for _ in $(seq 20); do
                sleep 1
                if swaymsg -q '[app_id="grokbot-lock-setup"] focus' 2>/dev/null; then
                    break
                fi
            done
        fi
        exit 0
        ;;
esac

if [[ $pin_state != "set" ]]; then
    echo "grokbot-lock: no PIN set, not locking" >&2
    notify-send -a "Grok Bot OS" "화면 잠금 PIN이 없습니다 / No screen-lock PIN" \
        "PIN을 설정하면 잠글 수 있습니다. / Set a PIN to enable the lock." 2>/dev/null || true
    open_setup
    [[ ${1:-} == "--suspend" ]] && systemctl suspend
    exit 0
fi

# Images may ship a touch keypad locker (Raspberry Pi 5: grokbot-lock-keypad,
# ext-session-lock + PAM). Fall back to swaylock if it is missing or fails.
keypad=${GROKBOT_LOCK_KEYPAD:-/usr/local/bin/grokbot-lock-keypad}
if pgrep -u "$user" -f 'grokbot-lock-keypad' >/dev/null || pgrep -u "$user" -x swaylock >/dev/null; then
    :
elif [[ -x $keypad ]] && "$keypad" -f; then
    :
else
    # -f: fork once the lock surface is up, so suspend happens after locking.
    swaylock -f -c 18181b --indicator-radius 80 --show-failed-attempts
fi
if [[ ${1:-} == "--suspend" ]]; then
    systemctl suspend
fi
