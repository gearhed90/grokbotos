#!/bin/bash
# Restart the Grok Bot UI whenever it exits.
# sway's `exec` runs once; it does not respawn a child that quits.
set -u

while true; do
    echo "grokbot-kiosk: launching $(date -Is)"
    /usr/local/bin/grokbot-launch || echo "grokbot-kiosk: launch exited $?"
    echo "grokbot-kiosk: restarting in 1s"
    sleep 1
done
