#!/bin/bash
# Change the dock layout for the current user and reload running docks.
#
#   grokbot-dock-config show
#   grokbot-dock-config set <top|bottom|left|right> <off|icons|labels>
#   grokbot-dock-config icon-size <16-96>
#   grokbot-dock-config reset
#
# Writes ~/.config/grokbot/dock.conf. Defaults stay in /etc/grokbot/dock.conf.
# top and bottom are icon-only; "labels" is refused there.
set -euo pipefail

SYS_CONF="${GROKBOT_DOCK_SYS_CONF:-/etc/grokbot/dock.conf}"
USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/grokbot"
USER_CONF="${USER_DIR}/dock.conf"

die() { echo "grokbot-dock-config: $*" >&2; exit 2; }

usage() {
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

# Print the effective value of key from sys then user conf.
get() {
    local key="$1" def="$2" f line
    local v="$def"
    for f in "$SYS_CONF" "$USER_CONF"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            line="${line%%#*}"
            if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*([^[:space:]]*) ]]; then
                v="${BASH_REMATCH[1]}"
            fi
        done <"$f"
    done
    printf '%s\n' "$v"
}

# Set key=value in the user conf, creating [dock].
put() {
    local key="$1" value="$2" tmp
    mkdir -p "$USER_DIR"
    [[ -f "$USER_CONF" ]] || printf '[dock]\n' >"$USER_CONF"
    tmp="$(mktemp "${USER_CONF}.XXXXXX")"
    awk -v k="$key" -v v="$value" '
        BEGIN { done = 0 }
        $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { if (!done) print k " = " v; done = 1; next }
        { print }
        END { if (!done) print k " = " v }
    ' "$USER_CONF" >"$tmp"
    mv "$tmp" "$USER_CONF"
}

reload() {
    pkill -HUP -u "$(id -u)" -f '/usr/lib/grokbot/grokbot-dock.py' 2>/dev/null || true
}

cmd="${1:-show}"
case "$cmd" in
    show)
        for e in top bottom left right; do
            d=off; [[ "$e" == bottom ]] && d=icons
            printf '%s = %s\n' "$e" "$(get "$e" "$d")"
        done
        printf 'icon_size = %s\n' "$(get icon_size 40)"
        ;;
    set)
        [[ $# -eq 3 ]] || die "usage: set <top|bottom|left|right> <off|icons|labels>"
        edge="$2" mode="$3"
        case "$edge" in top | bottom | left | right) ;; *) die "unknown edge: $edge" ;; esac
        case "$mode" in off | icons | labels) ;; *) die "unknown mode: $mode" ;; esac
        if [[ "$mode" == labels && ( "$edge" == top || "$edge" == bottom ) ]]; then
            die "top and bottom docks are icon-only"
        fi
        put "$edge" "$mode"
        reload
        ;;
    icon-size)
        [[ $# -eq 2 && "$2" =~ ^[0-9]+$ && "$2" -ge 16 && "$2" -le 96 ]] || die "icon-size needs 16-96"
        put icon_size "$2"
        reload
        ;;
    reset)
        rm -f "$USER_CONF"
        reload
        ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 2 ;;
esac
