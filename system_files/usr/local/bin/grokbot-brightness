#!/bin/bash
# Brightness keys: grokbot-brightness up|down|get  (brightnessctl, via logind)
set -euo pipefail
step=${GROKBOT_BRIGHTNESS_STEP:-5}

percent() {
    # brightnessctl -m: device,class,current,percent,max
    brightnessctl -m -c backlight 2>/dev/null | head -1 | cut -d, -f4 | tr -d '%'
}

if ! brightnessctl -l -c backlight 2>/dev/null | grep -q "Device"; then
    echo "grokbot-brightness: no backlight device" >&2
    exit 0
fi
case ${1:-} in
    up) brightnessctl -q -c backlight set "${step}%+" ;;
    # Never go fully dark from the keyboard.
    down) brightnessctl -q -c backlight -n 1% set "${step}%-" ;;
    get) percent; exit 0 ;;
    *) echo "usage: grokbot-brightness up|down|get" >&2; exit 2 ;;
esac
/usr/local/bin/grokbot-osd "$(percent)"
