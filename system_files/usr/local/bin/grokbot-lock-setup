#!/bin/bash
# Set or change the screen-lock PIN. Runs in a terminal window.
#   grokbot-lock-setup          interactive (first boot or change)
#   grokbot-lock-setup --status print "set" or "unset"
#   grokbot-lock-setup --skip   do not ask again at login
set -euo pipefail
state_dir=${GROKBOT_LOCK_STATE_DIR:-/var/lib/grokbot/lock-pin}
skip_file="${XDG_CONFIG_HOME:-$HOME/.config}/grokbot/lock-setup-skipped"
user=$(id -un)

if [[ ${1:-} == "--status" ]]; then
    if [[ -f $state_dir/$user ]]; then echo set; else echo unset; fi
    exit 0
fi
if [[ ${1:-} == "--skip" ]]; then
    mkdir -p "$(dirname "$skip_file")"
    : >"$skip_file"
    exit 0
fi

ask() {
    local prompt=$1 v
    IFS= read -r -s -p "$prompt" v
    echo >&2
    printf '%s' "$v"
}

echo "Set your screen-lock PIN"
echo "Used to unlock the screen. 6+ characters."
echo "Press Enter alone to skip for now."
echo
current=""
if [[ -f $state_dir/$user ]]; then
    current=$(ask "Current PIN: ")
fi
for _ in 1 2 3; do
    pin=$(ask "New PIN: ")
    if [[ -z $pin && -z $current ]]; then
        mkdir -p "$(dirname "$skip_file")"
        : >"$skip_file"
        echo "Skipped. Press Super+L or run grokbot-lock-setup later."
        sleep 3
        exit 0
    fi
    again=$(ask "Repeat: ")
    if [[ $pin != "$again" ]]; then
        echo "PINs do not match."
        continue
    fi
    if (( ${#pin} < 6 )); then
        echo "Must be at least 6 characters."
        continue
    fi
    if [[ -n $current ]]; then
        input=$(printf '%s\n%s\n' "$current" "$pin")
    else
        input=$(printf '%s\n' "$pin")
    fi
    if sudo -n /usr/lib/grokbot/lock-setpin.sh <<<"$input" >/dev/null; then
        rm -f "$skip_file"
        echo "PIN saved. Super+L locks the screen."
        sleep 3
        exit 0
    fi
    echo "Could not save the PIN."
    [[ -n $current ]] && exit 1
done
exit 1
