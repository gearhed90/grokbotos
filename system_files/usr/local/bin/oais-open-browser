#!/bin/sh
# xdg-open / $BROWSER target for the AI-OS kiosk shell (ROADMAP.md Phase 4).
#
# The kiosk's own desktop IS a Firefox --kiosk window (webshell_cli.py).
# Firefox is single-instance by default: a second `firefox <url>` (which is
# what a bare firefox.desktop Exec line, or `xdg-open`, or Node's `open`
# package via $BROWSER, would run) gets sent over Firefox's remoting
# protocol to that *already-running* kiosk instance and opens as a new tab
# inside the SAME window -- not a separate one. Kiosk mode hides all
# chrome, so that tab has no tab bar/back button, which made e.g. `claude
# auth login`'s OAuth success page permanently overwrite the kiosk UI with
# no way back (2026-07-13, docs/DECISIONS.md) -- webshell/wm.py's
# close-the-new-window logic never fired because there was no new window,
# just the same one's content getting replaced.
#
# --new-window forces Firefox's remoting to open a genuinely separate
# top-level window (its own sway con_id) instead of reusing a tab in the
# kiosk window, which is what wm.py's before/after `swaymsg -t get_tree`
# diff actually needs to find something to close.
exec firefox --new-window "$@"
