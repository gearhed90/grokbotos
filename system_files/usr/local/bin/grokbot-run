#!/bin/bash
# Run a command on a new, empty sway workspace so the app gets the whole
# usable area (inside the dock exclusive zones). Used as fuzzel's
# --launch-prefix. Grok Bot itself stays on workspace 1.
set -euo pipefail
[[ $# -gt 0 ]] || exit 0
used="$(swaymsg -r -t get_workspaces | python3 -c 'import json,sys; print(" ".join(str(w["num"]) for w in json.load(sys.stdin)))')"
n=2
while [[ " $used " == *" $n "* ]]; do n=$((n + 1)); done
printf -v cmd '%q ' "$@"
exec swaymsg "workspace number ${n}; exec ${cmd}"
