#!/bin/bash
# Desktop layer: draws the wallpaper with swaybg. sway runs this once.
# grokbot-wallpaper changes the config and kills swaybg; this loop then
# starts it again with the new values. No icons are ever drawn here.
set -u

SYS_CONF="${GROKBOT_DESKTOP_SYS_CONF:-/etc/grokbot/desktop.conf}"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/grokbot/desktop.conf"

get() {
    local key="$1" f line
    local v="$2"
    for f in "$SYS_CONF" "$USER_CONF"; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]]; then
                v="${BASH_REMATCH[1]}"
            fi
        done <"$f"
    done
    printf '%s\n' "$v"
}

while true; do
    img="$(get wallpaper "")"
    mode="$(get mode fill)"
    color="$(get color '#000000')"
    case "$mode" in fill | fit | stretch | center | tile) ;; *) mode=fill ;; esac
    [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]] || color='#000000'
    args=(-o '*' -c "$color")
    if [[ -n "$img" && -r "$img" ]]; then
        args+=(-i "$img" -m "$mode")
    else
        echo "grokbot-desktop: wallpaper not readable: ${img}" >&2
    fi
    swaybg "${args[@]}" || echo "grokbot-desktop: swaybg exited $?" >&2
    sleep 1
done
