#!/bin/bash
# Screenshots.
#   grokbot-capture [full]   whole screen (Print)
#   grokbot-capture region   select an area with the mouse (Shift+Print)
#   grokbot-capture dir      print the screenshot folder
# Saves PNG to ~/Pictures/Screenshots (GROKBOT_SCREENSHOT_DIR overrides),
# copies it to the clipboard and shows a notification.
set -euo pipefail
dir=${GROKBOT_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}
mode=${1:-full}

if [[ $mode == "dir" ]]; then
    echo "$dir"
    exit 0
fi
mkdir -p "$dir"
file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"
case $mode in
    full)
        grim "$file"
        ;;
    region)
        geom=$(slurp -d 2>/dev/null) || { echo "grokbot-capture: cancelled" >&2; exit 1; }
        grim -g "$geom" "$file"
        ;;
    *)
        echo "usage: grokbot-capture [full|region|dir]" >&2
        exit 2
        ;;
esac
if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png <"$file" || true
fi
notify-send -a "Grok Bot OS" -i "$file" \
    "스크린샷 저장 / Screenshot saved" \
    "$(basename "$file") — 클립보드에 복사됨 / copied to clipboard" 2>/dev/null || true
echo "$file"
