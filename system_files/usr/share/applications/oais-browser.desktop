[Desktop Entry]
Type=Application
Name=AI-OS Browser (new window)
Comment=Opens URLs in a new top-level Firefox window instead of a tab in the kiosk window
Exec=/usr/local/bin/oais-open-browser %u
Terminal=false
NoDisplay=true
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
