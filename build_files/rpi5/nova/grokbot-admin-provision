#!/bin/bash
# Grok Bot OS first boot: make sure the admin account "admin" exists (wheel,
# home dir). A brand-new or locked account gets the default password
# "password", marked expired, so the first login (console or SSH) must choose
# a new one. Runs every boot; does nothing once the account has a password.
set -euo pipefail
user=admin
if ! getent passwd "$user" >/dev/null; then
    useradd -m -G wheel -s /bin/bash -c "Grok Bot OS admin" "$user"
    echo "created $user"
fi
id -nG "$user" | grep -qw wheel || usermod -aG wheel "$user"
cur=$(getent shadow "$user" | cut -d: -f2)
if [[ -z $cur || $cur == '!'* || $cur == '*'* ]]; then
    printf '%s:%s\n' "$user" password | chpasswd
    chage -d 0 "$user"
    echo "set default password for $user (must be changed at first login)"
fi
