[Unit]
Description=Grok Bot OS: ensure the admin account exists
After=systemd-sysusers.service systemd-tmpfiles-setup.service local-fs.target
Before=systemd-user-sessions.service sshd.service getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/grokbot-admin-provision
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
