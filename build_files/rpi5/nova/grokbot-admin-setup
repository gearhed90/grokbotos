#!/bin/bash
# First boot on the Raspberry Pi 5 image: create the "admin" account (wheel,
# so it can use sudo) and have the owner choose its password on tty1, before
# the kiosk session starts. The image ships no password at all.
# Runs from grokbot-admin-setup.service until a password is set; if skipped,
# the account stays locked and this asks again on the next boot.
set -euo pipefail
user=${GROKBOT_ADMIN_USER:-admin}
done_file=${GROKBOT_ADMIN_DONE:-/var/lib/grokbot/admin-setup-done}

if ! id -u "$user" >/dev/null 2>&1; then
    useradd --create-home --groups wheel --comment "Grok Bot OS admin" "$user"
    passwd --lock "$user" >/dev/null
fi

clear || true
cat <<'MSG'
==============================================================
 Grok Bot OS - set the admin password
 관리자 비밀번호 설정
==============================================================
 This Pi has an admin account named "admin". It can install
 updates and run sudo (for example: sudo grokbot-set-xai-key).
 It has no password yet. Choose one now with the keyboard.
 It is not your screen PIN, and nobody else knows it.

 Press Enter on an empty password to skip; the account stays
 locked and this screen comes back on the next boot.
==============================================================
MSG
for _ in 1 2 3; do
    IFS= read -r -s -p "New admin password / 새 비밀번호: " p1; echo
    if [[ -z $p1 ]]; then
        echo "Skipped. Nova starts now. / 건너뜀."
        sleep 2
        exit 0
    fi
    IFS= read -r -s -p "Repeat / 한 번 더: " p2; echo
    if [[ $p1 != "$p2" ]]; then
        echo "The two passwords differ. / 서로 다릅니다."
        continue
    fi
    if (( ${#p1} < 8 )); then
        echo "Use at least 8 characters. / 8자 이상."
        continue
    fi
    # chpasswd reads user:password on stdin, so it never shows on a command line.
    if printf '%s:%s\n' "$user" "$p1" | chpasswd; then
        unset p1 p2
        passwd --unlock "$user" >/dev/null 2>&1 || true
        mkdir -p "$(dirname "$done_file")"
        : >"$done_file"
        echo "Saved. Log in as admin on another console (Ctrl+Alt+F2) or use sudo there."
        sleep 3
        exit 0
    fi
    echo "Could not set it. / 설정하지 못했습니다."
done
unset p1 p2
echo "Not set this time; asking again on the next boot."
sleep 3
exit 0
