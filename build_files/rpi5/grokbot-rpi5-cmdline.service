[Unit]
Description=Point the Raspberry Pi 5 FAT boot files at the default bootc deployment
After=local-fs.target
ConditionPathIsDirectory=/boot/loader/entries

[Service]
Type=oneshot
ExecStart=-/usr/bin/bash /usr/lib/grokbot/rpi5-sync-boot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
