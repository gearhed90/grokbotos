#!/bin/bash
# Cypher's dashboard (phase 4) lives on its own sway workspace so it never
# covers Nova or the Grok Bot app. Super+C shows it and, pressed again, goes
# back to where you were. "back" (a tap or Escape on the dashboard) only goes back.
#   grokbot-cypher-dash          toggle
#   grokbot-cypher-dash back     leave the dashboard
#   grokbot-cypher-dash show     show it (start it if needed)
set -euo pipefail
ws="9"
dash=/usr/share/grokbot/cypher/cypher-dash.py
if [[ -z "${SWAYSOCK:-}" ]]; then
    SWAYSOCK=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/sway-ipc.*.sock 2>/dev/null | head -1 || true)
    export SWAYSOCK
fi
current=$(swaymsg -r -t get_workspaces | python3 -c 'import json,sys
print(next((w["name"] for w in json.load(sys.stdin) if w.get("focused")), ""))')
mode="${1:-toggle}"
leave() {
    swaymsg -q workspace back_and_forth || true
    now=$(swaymsg -r -t get_workspaces | python3 -c 'import json,sys
print(next((w["name"] for w in json.load(sys.stdin) if w.get("focused")), ""))')
    if [[ "$now" == "$ws" ]]; then
        swaymsg -q workspace number 1
    fi
}
if [[ "$mode" == "back" ]]; then
    [[ "$current" == "$ws" ]] && leave
    exit 0
fi
if [[ "$mode" == "toggle" && "$current" == "$ws" ]]; then
    leave; exit 0
fi
if ! pgrep -u "$(id -u)" -f "cypher-dash.py" >/dev/null; then
    # Its own scope under a memory cap; it only reads one small JSON file.
    if command -v systemd-run >/dev/null; then
        swaymsg -q exec "systemd-run --user --scope --quiet -p MemoryMax=160M -p CPUQuota=50% /usr/bin/python3 $dash"
    else
        swaymsg -q exec "/usr/bin/python3 $dash"
    fi
fi
swaymsg -q workspace number "$ws"
