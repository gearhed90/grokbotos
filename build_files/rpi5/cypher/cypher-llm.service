[Unit]
Description=Cypher local fallback model (Qwen2.5 3B Q4 on llama.cpp, 127.0.0.1:8081 only)
Documentation=file:///usr/share/doc/grokbot/CYPHER.md
ConditionPathExists=/var/lib/cypher-llm/models/qwen2.5-3b-instruct-q4_k_m.gguf
After=cypher-llm-fetch.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# cypherd asks it only when Alpha is busy or away. Loopback only, its own
# throwaway user, capped so the kiosk stays responsive.
DynamicUser=yes
ExecStart=/usr/bin/llama-server -m /var/lib/cypher-llm/models/qwen2.5-3b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8081 -c 4096 -t 3 -np 1
Restart=on-failure
RestartSec=30
MemoryMax=3G
MemoryHigh=2600M
CPUQuota=300%
Nice=15
IOSchedulingClass=idle
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/cypher-llm

[Install]
WantedBy=multi-user.target
