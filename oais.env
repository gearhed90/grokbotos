# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=oais

# Make this the same as your github username/organisation
REPO_ORGANIZATION="head77x"

# Product name is Grok Bot OS. IMAGE_NAME stays "oais": GHCR repos are
# ghcr.io/head77x/oais and ghcr.io/head77x/oais-arm64, and the workflows
# derive the image name from this value. Do not rename it here.
IMAGE_DESC="Grok Bot OS: a bootc image that boots into the Grok Bot app"
IMAGE_KEYWORDS="bootc,oci,linux,grok,kiosk"

# Optional bake-in of the real Grok Bot Linux app. Leave unset for the
# placeholder. See docs/GROKBOT_APP.md.
# GROKBOT_APP_SOURCE=
# GROKBOT_APP_SHA256=
# GROKBOT_APP_KIND=
# GROKBOT_APP_EXEC=
# GROKBOT_FLATPAK_ID=
# GROKBOT_WEB_URL=

# Replace with a Grok Bot OS logo when one exists.
IMAGE_LOGO_URL="https://github.com/head77x.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
