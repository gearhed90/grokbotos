#!/usr/bin/env python3
"""onshape-pad-helper: turns signed button taps from the grokbotos Pi (nova-cadpad)
into Onshape keyboard shortcuts on this X11 desktop.

- Listens on PORT (8790), accepts only sources in ALLOW_NET (192.168.12.0/24).
- Every request is signed: X-Pad-Time, X-Pad-Nonce, X-Pad-Sig =
  hex HMAC-SHA256(token, METHOD\nPATH\nTIME\nNONCE\nBODY). +-30 s, nonces kept 120 s.
- Only named actions from actions.json; raw keys are never accepted.
- Keys go only to the Onshape PWA window (WM_CLASS FFPWA-...); refuses if it is not open.
- Logs action names and results only.
Disable: systemctl --user disable --now onshape-pad-helper
"""
import hashlib, hmac, ipaddress, json, os, re, stat, subprocess, sys, threading, time
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler

HOME = os.path.expanduser("~")
CFG_DIR = os.environ.get("PAD_CFG_DIR", os.path.join(HOME, ".config/nova/onshape-pad"))
LOG = os.environ.get("PAD_LOG", os.path.join(HOME, "nova-projects/onshape-pad/helper.log"))
PORT = int(os.environ.get("PAD_PORT", "8790"))
BIND = os.environ.get("PAD_BIND", "0.0.0.0")
ALLOW_NET = ipaddress.ip_network(os.environ.get("PAD_ALLOW_NET", "192.168.12.0/24"))
WM_CLASS = os.environ.get("PAD_WM_CLASS", "FFPWA-01KYTKB3ZGG24VKNPCBKP0S4KS")
XDOTOOL = os.environ.get("PAD_XDOTOOL", "/usr/bin/xdotool")
SKEW = 30
NONCE_TTL = 120
MAX_BODY = 1024
RATE = 20            # requests per second, all clients together
KEY_RE = re.compile(r"^(?:(?:ctrl|shift|alt|super)\+)*(?:[a-z0-9]|F[0-9]{1,2}|Return|Escape|space|Delete|"
                    r"BackSpace|Tab|Home|End|Page_Up|Page_Down|Up|Down|Left|Right|bracketleft|grave)$")
NAME_RE = re.compile(r"^[A-Za-z0-9 ./-]{1,40}$")

def log(msg):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line, file=sys.stderr, flush=True)

def load_token():
    p = os.path.join(CFG_DIR, "token")
    st = os.stat(p)
    if stat.S_IMODE(st.st_mode) & 0o077:
        sys.exit("token file must be mode 0600")
    t = open(p).read().strip()
    if len(t) < 32:
        sys.exit("token too short")
    return t.encode()

def load_actions():
    d = json.load(open(os.path.join(CFG_DIR, "actions.json")))["actions"]
    out = {}
    for name, a in d.items():
        if not re.match(r"^[a-z0-9_]{1,40}$", name):
            raise ValueError("bad action name " + name)
        if "keys" in a:
            if not a["keys"] or not all(KEY_RE.match(k) for k in a["keys"]):
                raise ValueError("bad keys for " + name)
            out[name] = {"keys": list(a["keys"])}
        elif "search" in a:
            if not NAME_RE.match(a["search"]):
                raise ValueError("bad search for " + name)
            out[name] = {"search": a["search"]}
        else:
            raise ValueError("action needs keys or search: " + name)
    return out

TOKEN = None
ACTIONS = {}
nonces = {}
nlock = threading.Lock()
press_lock = threading.Lock()
rate = []

def verify(method, path, headers, body):
    try:
        ts = int(headers.get("X-Pad-Time", ""))
    except ValueError:
        return "nosig"
    nonce = headers.get("X-Pad-Nonce", "")
    sig = headers.get("X-Pad-Sig", "")
    if not re.match(r"^[A-Za-z0-9_-]{8,64}$", nonce) or not re.match(r"^[0-9a-f]{64}$", sig):
        return "nosig"
    now = time.time()
    if abs(now - ts) > SKEW:
        return "stale"
    msg = b"\n".join([method.encode(), path.encode(), str(ts).encode(), nonce.encode(), body])
    want = hmac.new(TOKEN, msg, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(want, sig):
        return "badsig"
    with nlock:
        for k in [k for k, t in nonces.items() if now - t > NONCE_TTL]:
            del nonces[k]
        if nonce in nonces:
            return "replay"
        nonces[nonce] = now
    return None

def rate_ok():
    now = time.time()
    with nlock:
        rate[:] = [t for t in rate if now - t < 1]
        if len(rate) >= RATE:
            return False
        rate.append(now)
    return True

def xdo(*args, timeout=3):
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":0")
    env.setdefault("XAUTHORITY", os.path.join(HOME, ".Xauthority"))
    r = subprocess.run([XDOTOOL, *args], env=env, capture_output=True, text=True, timeout=timeout)
    return r.returncode, r.stdout.strip()

def onshape_windows():
    rc, out = xdo("search", "--onlyvisible", "--class", "^%s$" % re.escape(WM_CLASS))
    return [int(x) for x in out.split()] if rc == 0 and out else []

def active_window():
    rc, out = xdo("getactivewindow")
    try:
        return int(out) if rc == 0 else None
    except ValueError:
        return None

def ensure_focus():
    """Return True once an Onshape window is active. Never types anywhere else."""
    wins = onshape_windows()
    if not wins:
        return "onshape not open"
    if active_window() in wins:
        return None
    xdo("windowactivate", "--sync", str(wins[-1]), timeout=4)
    time.sleep(0.15)
    if active_window() in onshape_windows():
        return None
    return "could not focus onshape"

def press(name):
    a = ACTIONS.get(name)
    if a is None:
        return {"ok": False, "error": "unknown action"}
    with press_lock:
        err = ensure_focus()
        if err:
            return {"ok": False, "error": err}
        if "keys" in a:
            for k in a["keys"]:
                if ensure_focus():
                    return {"ok": False, "error": "focus lost"}
                xdo("key", "--clearmodifiers", k)
            return {"ok": True, "action": name}
        # No default shortcut: Onshape's tool search (Alt+C), type the name, Enter.
        xdo("key", "--clearmodifiers", "alt+c")
        time.sleep(0.45)
        if ensure_focus():
            return {"ok": False, "error": "focus lost"}
        xdo("type", "--delay", "25", a["search"], timeout=5)
        time.sleep(0.5)
        if ensure_focus():
            return {"ok": False, "error": "focus lost"}
        xdo("key", "Return")
        return {"ok": True, "action": name, "via": "search"}

class H(BaseHTTPRequestHandler):
    server_version = "onshape-pad/1"
    sys_version = ""
    def log_message(self, *a):
        pass
    def _src_ok(self):
        try:
            return ipaddress.ip_address(self.client_address[0]) in ALLOW_NET
        except ValueError:
            return False
    def _json(self, code, obj):
        d = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(d)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(d)
    def _gate(self, body):
        if not self._src_ok():
            self.close_connection = True
            return self._json(403, {"ok": False, "error": "forbidden"}) or False
        if not rate_ok():
            return self._json(429, {"ok": False, "error": "slow down"}) or False
        e = verify(self.command, self.path, self.headers, body)
        if e:
            log("refused %s %s: %s" % (self.command, self.path, e))
            return self._json(401, {"ok": False, "error": e}) or False
        return True
    def do_GET(self):
        if self.path != "/health":
            return self._json(404, {"ok": False, "error": "not found"})
        if not self._gate(b""):
            return
        self._json(200, {"ok": True, "onshape_open": bool(onshape_windows()), "actions": len(ACTIONS)})
    def do_POST(self):
        if self.path != "/press":
            return self._json(404, {"ok": False, "error": "not found"})
        try:
            n = int(self.headers.get("Content-Length", "0") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > MAX_BODY:
            return self._json(413, {"ok": False, "error": "too large"})
        body = self.rfile.read(n)
        if not self._gate(body):
            return
        try:
            name = json.loads(body).get("action", "")
            if not isinstance(name, str):
                raise ValueError
        except (ValueError, AttributeError):
            return self._json(400, {"ok": False, "error": "bad request"})
        r = press(name)
        log("press %s -> %s" % (name if name in ACTIONS else "<unknown>", "ok" if r.get("ok") else r.get("error")))
        self._json(200 if r.get("ok") else 409, r)

def main():
    global TOKEN, ACTIONS
    TOKEN = load_token()
    ACTIONS = load_actions()
    srv = ThreadingHTTPServer((BIND, PORT), H)
    srv.daemon_threads = True
    log("listening on %s:%d, allow %s, %d actions" % (BIND, PORT, ALLOW_NET, len(ACTIONS)))
    srv.serve_forever()

if __name__ == "__main__":
    main()
