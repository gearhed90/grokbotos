# Raspberry Pi 5 image. Same Grok Bot OS userspace as Containerfile, then
# the downstream Pi kernel and firmware. Do not use this file for the
# generic UEFI arm64 image (UTM / Apple Silicon).
FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files
COPY grokbot-app /grokbot-app

# vcgencmd builder: compiles only vcgencmd from raspberrypi/utils at a
# pinned commit (build_files/rpi5-build-vcgencmd.sh). Same base as the
# image so glibc matches; gcc, cmake and git never reach the final image.
FROM quay.io/fedora/fedora-bootc:latest@sha256:1a17d180491130098b6881300ff3bbe74d37cc40968af4fbf3d5945a9779bb73 AS vcgencmd
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,id=grokbot-rpi5-vcgencmd,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/rpi5-build-vcgencmd.sh

FROM quay.io/fedora/fedora-bootc:latest@sha256:1a17d180491130098b6881300ff3bbe74d37cc40968af4fbf3d5945a9779bb73

ARG GROKBOT_APP_SOURCE=
ARG GROKBOT_APP_SHA256=
ARG GROKBOT_APP_KIND=auto
ARG GROKBOT_APP_EXEC=
ARG GROKBOT_FLATPAK_ID=
ARG GROKBOT_WEB_URL=
ARG GROKBOT_TARGET_ARCH
ARG GROKBOT_DISABLE_BUNDLED_APP
ARG TARGETARCH

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

# Swap the Fedora kernel for kernel-rpi5 and stage the FAT boot files.
# See build_files/rpi5-prepare.sh and PI5-STATUS.md.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/rpi5-prepare.sh

# Nova main screen, keypad lock, codecs, admin first boot (build_files/rpi5-nova.sh).
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/rpi5-nova.sh

# vcgencmd (get_throttled etc.). /dev/vcio access: rpi5-prepare.sh.
COPY --from=vcgencmd /out/vcgencmd /usr/bin/vcgencmd

# bootc's lint needs syscalls qemu-user does not implement (ENOSYS, os
# error 38) when this arm64 image is built emulated on x86_64. Skip it only
# in that case; any real lint failure still stops the build.
RUN out=$(bootc container lint 2>&1) && echo "$out" || { echo "$out"; \
    echo "$out" | grep -q 'os error 38' || exit 1; \
    echo 'warning: bootc container lint skipped (not supported under qemu emulation)'; }
